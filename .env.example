# Public domain or public IP of your router/server (WAN IP or DDNS)
# DO NOT put internal private IPs here if clients connect from outside!
WG_HOST=vpn.example.com

# Web UI admin password
# Generate a hashed password using: docker run --rm -it ghcr.io/wg-easy/wg-easy wgpw 'YOUR_PASSWORD'
# Or plain text if supported by your setup
PASSWORD_HASH=$$2a$$12$$...

# Web UI port (on server host)
UI_PORT=51821

# WireGuard UDP Port (must be forwarded on your router to server)
WG_PORT=51820

# Internal WireGuard subnet for VPN clients
WG_DEFAULT_ADDRESS=10.8.0.x

# DNS server provided to clients (Cloudflare / Google)
WG_DEFAULT_DNS=1.1.1.1
