# Public domain or public IP of your router/server (WAN IP or DDNS)
# DO NOT put internal private IPs here if clients connect from outside!
WG_HOST=vpn.example.com

# Web UI admin password
# Generate a hashed password using: docker run --rm -it ghcr.io/wg-easy/wg-easy wgpw 'YOUR_PASSWORD'
# Or plain text if supported by your setup
PASSWORD_HASH=$$2a$$12$$...

# Web UI port (on server host)
UI_PORT=51821

# WireGuard UDP Port (must be forwarded on your router to server)
WG_PORT=51820

# Internal WireGuard subnet for VPN clients
WG_DEFAULT_ADDRESS=10.9.0.x

# Default AllowedIPs for generated client configs (set to TikTok subnets for split tunneling)
# Generated via scripts/generate_tiktok_routes.py
WG_ALLOWED_IPS=71.18.1.0/24, 71.18.2.0/23, 71.18.4.0/22, 71.18.8.0/24, 71.18.10.0/23, 71.18.12.0/23, 71.18.16.0/22, 71.18.20.0/23, 71.18.24.0/23, 71.18.26.0/24, 71.18.29.0/24, 71.18.30.0/23, 71.18.32.0/21, 71.18.41.0/24, 71.18.42.0/23, 71.18.44.0/22, 71.18.48.0/22, 71.18.52.0/23, 71.18.56.0/22, 71.18.60.0/24, 71.18.64.0/22, 71.18.71.0/24, 71.18.72.0/22, 71.18.77.0/24, 71.18.79.0/24, 71.18.80.0/23, 71.18.82.0/24, 71.18.84.0/22, 71.18.88.0/21, 71.18.96.0/20, 71.18.112.0/23, 71.18.116.0/22, 71.18.120.0/21, 71.18.128.0/20, 71.18.144.0/22, 71.18.148.0/23, 71.18.150.0/24, 71.18.152.0/21, 71.18.160.0/21, 71.18.168.0/22, 71.18.175.0/24, 71.18.176.0/22, 71.18.180.0/24, 71.18.182.0/23, 71.18.184.0/22, 71.18.188.0/24, 71.18.196.0/23, 71.18.199.0/24, 71.18.200.0/21, 71.18.208.0/21, 71.18.216.0/22, 71.18.222.0/23, 71.18.224.0/24, 71.18.228.0/24, 71.18.231.0/24, 71.18.232.0/24, 71.18.237.0/24, 71.18.238.0/23, 71.18.240.0/23, 71.18.243.0/24, 71.18.244.0/22, 71.18.248.0/22, 71.18.252.0/23, 71.18.255.0/24, 101.45.0.0/24, 101.45.2.0/23, 101.45.4.0/23, 101.45.6.0/24, 101.45.8.0/24, 101.45.11.0/24, 101.45.12.0/22, 101.45.16.0/22, 101.45.20.0/24, 101.45.23.0/24, 101.45.25.0/24, 101.45.27.0/24, 101.45.28.0/24, 101.45.192.0/22, 101.45.198.0/23, 101.45.200.0/21, 101.45.236.0/22, 101.45.248.0/22, 103.136.220.0/23, 103.136.223.0/24, 103.179.198.0/23, 130.44.212.0/24, 130.44.214.0/23, 139.177.225.0/24, 139.177.227.0/24, 139.177.233.0/24, 139.177.235.0/24, 139.177.238.0/24, 139.177.240.0/21, 139.177.248.0/24, 147.160.176.0/23, 147.160.180.0/24, 147.160.182.0/24, 147.160.184.0/24, 147.160.190.0/24, 180.240.234.0/23, 192.64.15.0/24, 199.103.24.0/23, 202.52.240.0/21

